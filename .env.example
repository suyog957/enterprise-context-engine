# Local development only. Change these values before exposing services.
ENVIRONMENT=local
POSTGRES_DB=enterprise_context
POSTGRES_USER=context_app
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql://context_app:local_dev_only_change_me@127.0.0.1:5432/enterprise_context

# Local service endpoints
FUSEKI_URL=http://127.0.0.1:3030/enterprise
FUSEKI_ADMIN_USER=admin
FUSEKI_ADMIN_PASSWORD=local_dev_only_change_me
OPENSEARCH_URL=http://127.0.0.1:9200
OPA_URL=http://127.0.0.1:8181
DATA_DIR=data

# The first implementation uses a deterministic mock model.
LLM_PROVIDER=mock
DRY_RUN=true
