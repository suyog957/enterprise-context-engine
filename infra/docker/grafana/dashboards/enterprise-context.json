      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, store) (rate(ecg_store_latency_seconds_bucket[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
